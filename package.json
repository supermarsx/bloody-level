{
  "name": "bloody-level",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "format": "npx --yes prettier@3.9.5 --write \"**/*.{js,ts,json,md,css,html,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "npx --yes prettier@3.9.5 --check \"**/*.{js,ts,json,md,css,html,yml,yaml}\" --ignore-path .gitignore",
    "lint": "npx --yes oxlint@1.74.0 src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "icon:rebuild": "node src-tauri/icons/source/rasterize.mjs && tauri icon src-tauri/icons/source/icon-1024.png -o src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.3",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
